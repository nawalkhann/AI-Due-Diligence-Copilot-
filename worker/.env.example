# Direct Postgres connection (Supabase: Project settings > Database > Connection string,
# "Session pooler" or direct). The worker bypasses RLS, so keep this secret.
DDC_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

DDC_STORAGE_BACKEND=supabase
DDC_SUPABASE_URL=https://your-project.supabase.co
DDC_SUPABASE_SERVICE_ROLE_KEY=
DDC_STORAGE_BUCKET=documents

# voyage for production, fake for offline development
DDC_EMBEDDING_PROVIDER=voyage
DDC_VOYAGE_API_KEY=
DDC_EMBEDDING_MODEL=voyage-finance-2
